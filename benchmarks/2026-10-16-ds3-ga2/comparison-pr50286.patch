+                       {"other = f32[256]{0} negate(x)",
+                        "other = f32[256]{0} negate(y)"}})));
+    RecomputeFusionSideOutputs pass(AllowForTest, 0);
+    ASSERT_OK_AND_ASSIGN(bool changed, RunHloPass(&pass, module.get()));
+    EXPECT_TRUE(changed);
+  }
+}
